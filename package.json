{
  "name": "discord-irc",
  "version": "2.9.0",
  "description": "Connects IRC and Discord channels by sending messages back and forth.",
  "keywords": [
    "discord",
    "irc",
    "gateway",
    "bot",
    "discord-irc",
    "reactiflux"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "babel lib --out-dir dist",
    "format": "prettier --write '{lib,test}/**/*.?s'",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json",
    "save-coverage": "nyc report --reporter=lcov",
    "test": "mocha --require @babel/register -- 'test/*.test.js'"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^7.2.0",
    "discord.js": "^13.10.3",
    "irc-colors": "1.5.0",
    "irc-formatting": "1.0.0-rc3",
    "irc-upd": "0.11.0",
    "lodash": "^4.17.21",
    "simple-markdown": "^0.7.3",
    "strip-json-comments": "^5",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@babel/cli": "^7",
    "@babel/core": "^7",
    "@babel/preset-env": "^7",
    "@babel/register": "^7",
    "@eslint/js": "^10",
    "@tsconfig/node24": "^24",
    "@types/chai": "^5.2.3",
    "@types/lodash": "^4",
    "@types/mocha": "^10",
    "@types/node": "^24",
    "chai": "^6.2.2",
    "eslint": "^10",
    "globals": "^17",
    "mocha": "^12.0.2",
    "prettier": "~3.9",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8"
  }
}
